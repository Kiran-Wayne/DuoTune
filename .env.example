# Supabase project URL, e.g. https://YOUR_PROJECT.supabase.co
SUPABASE_URL=
# Supabase publishable key (or legacy anon key). Safe to use in browser and server.
SUPABASE_PUBLISHABLE_KEY=
# Supabase service_role key. SERVER ONLY. Never put this in index.html.
SUPABASE_SERVICE_ROLE_KEY=
# Same shared password currently used by the Kiran/Pooja room login.
DUOTUNE_SHARED_PASSWORD=
# Room code configured in duotune_rooms.
DUOTUNE_ROOM_CODE=KIRANUU
# Comma-separated frontend origins. Add your deployed frontend origin.
DUOTUNE_ALLOWED_ORIGINS=https://duotune.vercel.app,http://localhost:3000,http://127.0.0.1:5500
# Port supplied by most hosts automatically.
PORT=3000

# InnerTube client locale for music search
INNERTUBE_LANGUAGE=en
INNERTUBE_LOCATION=IN
